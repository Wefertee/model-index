#!/bin/sh
# post-receive: выкладывает ветку main в /opt/model-index и перезапускает службу.
# Лежит в репозитории, на сервере копируется в /srv/git/model-index.git/hooks/.

GIT_DIR=/srv/git/model-index.git
WORK=/opt/model-index
BRANCH=main

while read -r oldrev newrev refname; do
  case "$refname" in
    refs/heads/$BRANCH) ;;
    *) continue ;;
  esac

  echo "→ выкладываю $BRANCH в $WORK"
  git --git-dir="$GIT_DIR" --work-tree="$WORK" checkout -f "$BRANCH"
  # удаляем файлы, которых больше нет в репозитории (ignored-файлы, в т.ч. feedback.db, не трогаем)
  git --git-dir="$GIT_DIR" --work-tree="$WORK" clean -fd

  chown -R modelindex:modelindex "$WORK" || true

  if command -v systemctl >/dev/null 2>&1; then
    systemctl restart model-index || echo "! служба не перезапустилась — смотри journalctl -u model-index"
  fi
  echo "✓ готово"
done
